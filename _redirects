https://neora-ai.com/* https://neoratools.com/:splat 301!
https://www.neora-ai.com/* https://neoratools.com/:splat 301!


# ══════════════════════════════════════════════════════════════════
# Neora AI — _redirects
# Rule order matters: first match wins.
# ══════════════════════════════════════════════════════════════════

# ── 1. Blog listing + post pages ──────────────────────────────────
/blog/    /blog/index.html    200
/blog/*   /blog/post.html     200

# ── 2. JSON data files — must bypass the SPA wildcard ─────────────
/_posts-json/*       /_posts-json/:splat    200
/tools-index.json    /tools-index.json     200
/posts-index.json    /posts-index.json     200
/compare-index.json  /compare-index.json   200

# ── 3. Comparisons — explicit rule so it never falls through
#    to the SPA wildcard below ─────────────────────────────────────
/compare/    /compare/index.html    200

# ── 4. Tools — listing lives at /tool/index.html;
#    individual detail pages live at /tool/detail.html.
#    /tools/ (plural) is kept as a safety-net alias so any old
#    or mistyped links never 404. ────────────────────────────────
/tool/      /tool/index.html     200
/tool       /tool/index.html     200
/tools/     /tool/index.html     200
/tools/*    /tool/detail.html    200

# ── 5. Stopgap aliases for nav links with no dedicated page yet ───
/categories/    /tool/     301
/guides/        /blog/     301
/privacy/       /privacy-policy/    301
/privacy        /privacy-policy/    301

# ── 4b. Legacy root HTML stubs ───────────────────────────────────
/blog.html      /blog/     301
/compare.html   /compare/  301
/tools.html     /tools/    301
/tool.html      /tools/    301
/reviews.html   /blog/     301

# ── 6. Static asset passthrough ────────────────────────────────────
/assets/*    /assets/:splat    200
/images/*    /images/:splat    200

# ── 7. Netlify CMS admin ───────────────────────────────────────────
/admin       /admin/index.html    200
/admin/*     /admin/index.html    200

# ── 8. SPA fallback — must be last ─────────────────────────────────
/*    /index.html    200
